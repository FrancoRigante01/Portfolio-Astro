---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
---

<ProjectLayout
    lang="en"
    title="Arcade Video Game | Franco Rigante"
    description="Independent arcade video game built with web technologies, playable directly in the browser."
>
    <h2>Arcade Video Game</h2>
    <p>
        An arcade video game developed as a personal project, available to
        play directly in the browser.
    </p>

    <ProjectGallery
        heading="Project screenshots"
        images={[
            {
                src: "/assets/arcade_game/gameplay.gif",
                alt: "Gameplay of the arcade video game in action",
                caption: "Gameplay in action",
            },
            {
                src: "/assets/arcade_game/Captura de pantalla 2025-09-18 212143.png",
                alt: "Screenshot of the arcade game 1",
                caption: "Start screen",
            },
            {
                src: "/assets/arcade_game/Captura de pantalla 2025-09-18 212156.png",
                alt: "Screenshot of the arcade game 2",
                caption: "Main game view",
            },
        ]}
    />

    <h3>Main features</h3>
    <div class="project-features">
        <div class="feature-card">
            <h4>🎮 Classic Arcade Game</h4>
            <p>
                Fun mechanics inspired by classic arcade games
            </p>
        </div>
        <div class="feature-card">
            <h4>🌐 Web Technologies</h4>
            <p>
                Built with modern web technologies for maximum compatibility
            </p>
        </div>
        <div class="feature-card">
            <h4>📱 Responsive Interface</h4>
            <p>Intuitive design that adapts to any device</p>
        </div>
        <div class="feature-card">
            <h4>🚀 Independent Publishing</h4>
            <p>Available on independent game platforms</p>
        </div>
    </div>

    <h3>Technologies used</h3>
    <div class="tech-stack">
        <span class="tech-tag">React</span>
        <span class="tech-tag">TypeScript</span>
        <span class="tech-tag">HTML5</span>
        <span class="tech-tag">CSS3</span>
    </div>

    <div class="project-links">
        <a
            href="https://mariscalchino.itch.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
        >
            🎮 Play on Itch.io
        </a>
        <a
            href="https://github.com/FrancoRigante01/Driftbot"
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
        >
            📂 View code on GitHub
        </a>
    </div>
</ProjectLayout>
