---
import ProjectLayout from "../layouts/ProjectLayout.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
---

<ProjectLayout
    title="Videojuego Arcade Web | Franco Rigante"
    description="Videojuego arcade independiente desarrollado con tecnologías web, jugable directamente en el navegador."
>
    <h2>Videojuego Arcade Web</h2>
    <p>
        Un videojuego arcade desarrollado como proyecto personal, disponible
        para jugar directamente en el navegador.
    </p>

    <ProjectGallery
        images={[
            {
                src: "/assets/arcade_game/gameplay.gif",
                alt: "Gameplay del videojuego arcade en acción",
                caption: "Gameplay en acción",
            },
            {
                src: "/assets/arcade_game/Captura de pantalla 2025-09-18 212143.png",
                alt: "Captura de pantalla del juego arcade 1",
                caption: "Interfaz de inicio",
            },
            {
                src: "/assets/arcade_game/Captura de pantalla 2025-09-18 212156.png",
                alt: "Captura de pantalla del juego arcade 2",
                caption: "Vista principal del juego",
            },
        ]}
    />

    <h3>Características principales</h3>
    <div class="project-features">
        <div class="feature-card">
            <h4>🎮 Juego Arcade Clásico</h4>
            <p>
                Mecánicas divertidas inspiradas en los clásicos juegos
                arcade
            </p>
        </div>
        <div class="feature-card">
            <h4>🌐 Tecnologías Web</h4>
            <p>
                Desarrollado con tecnologías web modernas para máxima
                compatibilidad
            </p>
        </div>
        <div class="feature-card">
            <h4>📱 Interfaz Responsive</h4>
            <p>Diseño intuitivo que se adapta a cualquier dispositivo</p>
        </div>
        <div class="feature-card">
            <h4>🚀 Publicación Independiente</h4>
            <p>Disponible en plataformas de juegos independientes</p>
        </div>
    </div>

    <h3>Tecnologías utilizadas</h3>
    <div class="tech-stack">
        <span class="tech-tag">React</span>
        <span class="tech-tag">TypeScript</span>
        <span class="tech-tag">HTML5</span>
        <span class="tech-tag">CSS3</span>
    </div>

    <div class="project-links">
        <a
            href="https://mariscalchino.itch.io/"
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
        >
            🎮 Jugar en Itch.io
        </a>
        <a
            href="https://github.com/FrancoRigante01/Driftbot"
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
        >
            📂 Ver código en GitHub
        </a>
    </div>
</ProjectLayout>
