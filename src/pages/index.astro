---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
<Header className="main-header" animate={true} id="inicio" />

<Nav links={[
  { href: "#inicio", text: "Inicio" },
  { href: "#servicios", text: "Servicios" },
  { href: "#proyectos", text: "Proyectos" },
  { href: "#experiencia", text: "Experiencia" },
  { href: "#formacion", text: "Formación" },
  { href: "#habilidades", text: "Habilidades" },
  { href: "#contacto", text: "Contacto" }
]} />

        <section class="bio">
            <h2>Sobre mí</h2>
            <p>Desarrollador de software especializado en tecnologías web. Trabajo principalmente con React y TypeScript, creando aplicaciones, interfaces y funcionalidades que combinan rendimiento, escalabilidad y usabilidad.</p>
        </section>

        <section id="servicios">
            <h2>Servicios</h2>
            <p>Desarrollo de sitios y aplicaciones web a medida, desde la idea inicial hasta el mantenimiento.</p>
            <div class="servicios-grid">
                <div class="servicio proyecto">
                    <h3>Desarrollo de landing pages</h3>
                    <p>Páginas de presentación rápidas, responsivas y pensadas para convertir visitas en consultas.</p>
                </div>
                <div class="servicio proyecto">
                    <h3>Aplicaciones web con React</h3>
                    <p>Aplicaciones a medida con React y TypeScript, desde prototipos hasta productos listos para producción.</p>
                </div>
                <div class="servicio proyecto">
                    <h3>Creación y mejora de interfaces</h3>
                    <p>Diseño e implementación de interfaces claras y funcionales, o rediseño de pantallas existentes para mejorar la experiencia de usuario.</p>
                </div>
                <div class="servicio proyecto">
                    <h3>Corrección de errores y mantenimiento</h3>
                    <p>Diagnóstico y resolución de bugs, optimización de rendimiento y mantenimiento de proyectos existentes.</p>
                </div>
                <div class="servicio proyecto">
                    <h3>Integración de APIs</h3>
                    <p>Conexión de tu sitio o aplicación con APIs externas o propias, con manejo de datos y autenticación.</p>
                </div>
            </div>
            <p class="servicios-cta">¿Necesitás algo de esto? <a href="#contacto">Escribime y lo conversamos.</a></p>
        </section>

        <section id="experiencia">
            <h2>Experiencia</h2>
                <div class="experiencia-item">
                    <h3>Softtek - Desarrollador de Software</h3>
                    <p><strong>Duración:</strong> Desde marzo de 2025</p>
                    <p><strong>Tecnologías:</strong> React, TypeScript, Firebase, TailwindCSS, Material UI, Playwright, PostgreSQL</p>
                    <p><strong>Proyectos:</strong> Portal de proveedores, gestión de formularios web, vault para workspaces, preventa para soluciones IA, desarrollo de demos y POCs técnicas para clientes</p>
                    <p><strong>Logros:</strong> Resolución de bugs, mejoras de UI, optimización de rendimiento, desarrollo de nuevas funcionalidades en varias aplicaciones.</p>
                </div>

            </section>

        <section id="formacion">
            <h2>Formación</h2>

            <div class="formacion-item">
                <h3>Realizador en Artes Electrónicas (Tecnicatura)</h3>
                <p><strong>Universidad Nacional de Tres de Febrero</strong> (2020 - 2026)</p>
            </div>

            <div class="formacion-item">
                <h3>Cursos y Certificaciones</h3>
                <ul>
                    <li>Introducción a la Ciberseguridad - Cisco Networking Academy</li>
                    <li>Redes Inalámbricas - Educación IT</li>
                    <li>Curso introductorio de Java</li>
                </ul>
            </div>
        </section>

        <section id="proyectos">
            <h2>Proyectos Destacados</h2>
            <div class="proyectos-grid">
                <div class="proyecto">
                    <h3><a href="/pokemon-app">Pokemon App</a></h3>
                    <p>Lista interactiva de Pokémon con filtrado, paginación y autenticación de usuarios. <a href="https://pokemon-app-70087.web.app" target="_blank">Ver proyecto</a></p>
                </div>
                <div class="proyecto">
                    <h3><a href="/hipnos">Hipnos</a></h3>
                    <p>Interpretador de sueños con reconocimiento de voz y sistema de logros. <a href="https://hipnos.netlify.app/" target="_blank">Ver proyecto</a></p>
                </div>
                <div class="proyecto">
                    <h3><a href="/arcade-game">Videojuegos en Itch.io</a></h3>
                    <p>Desarrollo de videojuegos independientes. <a href="https://mariscalchino.itch.io/" target="_blank">Ver perfil</a></p>
                </div>
            </div>
        </section>

        <section id="habilidades">
            <h2>Habilidades Técnicas</h2>
            <div class="skills-group">
                <h3>Frontend</h3>
                <ul class="skills-list">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                    <li>TypeScript</li>
                    <li>React</li>
                    <li>TailwindCSS</li>
                    <li>Astro</li>
                </ul>
            </div>
            <div class="skills-group">
                <h3>Backend / Datos</h3>
                <ul class="skills-list">
                    <li>Firebase</li>
                    <li>Firestore</li>
                    <li>PostgreSQL</li>
                    <li>Python</li>
                </ul>
            </div>
            <div class="skills-group">
                <h3>Herramientas</h3>
                <ul class="skills-list">
                    <li>Git</li>
                    <li>GitHub</li>
                    <li>Playwright</li>
                    <li>Vite</li>
                </ul>
            </div>
        </section>

        <section id="contacto">
            <h2>Contacto</h2>
            <p>Podés contactarme por correo electrónico:
                <a id="mail-link" href="#" rel="noopener" style="word-break: break-all;"></a>
            </p>
        </section>

<Footer />
        <script src="/assets/functions/mail.js" defer></script>
</Layout>

<style>
/* SECCIONES GENERALES, PROYECTOS, HABILIDADES, CONTACTO */
section {
  max-width: 800px;
  margin: 2rem auto;
  background: var(--color-secondary);
  border-radius: 12px;
  box-shadow: var(--shadow-medium);
  padding: 2rem;
}
.proyectos-grid,
.servicios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}
.servicios-cta {
  margin-top: 1.5rem;
  margin-bottom: 0;
  text-align: center;
}
.proyecto {
  background: var(--color-background);
  border-radius: 8px;
  padding: 1rem;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
  transition: transform 0.2s, box-shadow 0.2s;
}
.proyecto:hover, .proyecto:focus {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 6px 24px rgba(122,182,255,0.25), 0 1.5px 8px rgba(0,0,0,0.18);
  z-index: 2;
}
.skills-group {
  margin-bottom: 1.5rem;
}
.skills-group:last-child {
  margin-bottom: 0;
}
.skills-group h3 {
  margin: 0 0 0.6rem 0;
}
.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  list-style: none;
  padding: 0;
  margin: 0;
}
.skills-list li {
  background: var(--color-background);
  border-radius: var(--border-radius);
  padding: 0.5rem 1rem;
  font-weight: 500;
  color: var(--color-primary);
}
</style>
