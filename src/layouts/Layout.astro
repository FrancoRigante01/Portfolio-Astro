---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/responsive.css';
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Franco Rigante | Desarrollador de Software',
	description = 'Portfolio de Franco Rigante, desarrollador de software especializado en React, TypeScript y tecnologías web.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content="Astro" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<ThemeToggle />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
