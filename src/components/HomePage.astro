---
import Header from './Header.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { ui, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const cvHref = lang === 'en' ? '/CV-Franco-Rigante-EN.pdf' : '/CV-Franco-Rigante.pdf';
const base = lang === 'es' ? '' : '/en';
---

<Header className="main-header" animate={true} id="inicio" subtitle={t.subtitle} photoAlt={t.photoAlt} />

<Nav links={[
  { href: "#inicio", text: t.nav.home },
  { href: "#servicios", text: t.nav.services },
  { href: "#proyectos", text: t.nav.projects },
  { href: "#experiencia", text: t.nav.experience },
  { href: "#formacion", text: t.nav.education },
  { href: "#habilidades", text: t.nav.skills },
  { href: "#contacto", text: t.nav.contact }
]} />

        <section class="bio">
            <h2>{t.about.heading}</h2>
            <p>{t.about.text}</p>
            <p class="cv-download">
                <a href={cvHref} download>{t.about.cv}</a>
            </p>
        </section>

        <section id="servicios">
            <h2>{t.services.heading}</h2>
            <p>{t.services.intro}</p>
            <div class="servicios-grid">
                {t.services.items.map((item) => (
                    <div class="servicio proyecto">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </div>
                ))}
            </div>
            <p class="servicios-cta">{t.services.ctaQuestion} <a href="#contacto">{t.services.ctaLink}</a></p>
        </section>

        <section id="experiencia">
            <h2>{t.experience.heading}</h2>
                <div class="experiencia-item">
                    <h3>{t.experience.role}</h3>
                    <p><strong>{t.experience.durationLabel}</strong> {t.experience.duration}</p>
                    <p><strong>{t.experience.technologiesLabel}</strong> {t.experience.technologies}</p>
                    <p><strong>{t.experience.projectsLabel}</strong> {t.experience.projects}</p>
                    <p><strong>{t.experience.achievementsLabel}</strong> {t.experience.achievements}</p>
                </div>

            </section>

        <section id="formacion">
            <h2>{t.education.heading}</h2>

            <div class="formacion-item">
                <h3>{t.education.degree}</h3>
                <p><strong>{t.education.university}</strong> {t.education.years}</p>
            </div>

            <div class="formacion-item">
                <h3>{t.education.certsHeading}</h3>
                <ul>
                    {t.education.certs.map((cert) => <li>{cert}</li>)}
                </ul>
            </div>
        </section>

        <section id="proyectos">
            <h2>{t.projects.heading}</h2>
            <div class="proyectos-grid">
                <div class="proyecto">
                    <h3><a href={`${base}/pokemon-app`}>{t.projects.pokemon.title}</a></h3>
                    <p>{t.projects.pokemon.text} <a href="https://pokemon-app-70087.web.app" target="_blank" rel="noopener noreferrer">{t.projects.viewProject}</a></p>
                </div>
                <div class="proyecto">
                    <h3><a href={`${base}/hipnos`}>{t.projects.hipnos.title}</a></h3>
                    <p>{t.projects.hipnos.text} <a href="https://hipnos.netlify.app/" target="_blank" rel="noopener noreferrer">{t.projects.viewProject}</a></p>
                </div>
                <div class="proyecto">
                    <h3><a href={`${base}/arcade-game`}>{t.projects.games.title}</a></h3>
                    <p>{t.projects.games.text} <a href="https://mariscalchino.itch.io/" target="_blank" rel="noopener noreferrer">{t.projects.viewProfile}</a></p>
                </div>
            </div>
        </section>

        <section id="habilidades">
            <h2>{t.skills.heading}</h2>
            <div class="skills-group">
                <h3>{t.skills.frontend}</h3>
                <ul class="skills-list">
                    <li>HTML</li>
                    <li>CSS</li>
                    <li>JavaScript</li>
                    <li>TypeScript</li>
                    <li>React</li>
                    <li>TailwindCSS</li>
                    <li>Astro</li>
                </ul>
            </div>
            <div class="skills-group">
                <h3>{t.skills.backend}</h3>
                <ul class="skills-list">
                    <li>Firebase</li>
                    <li>Firestore</li>
                    <li>PostgreSQL</li>
                    <li>Python</li>
                </ul>
            </div>
            <div class="skills-group">
                <h3>{t.skills.tools}</h3>
                <ul class="skills-list">
                    <li>Git</li>
                    <li>GitHub</li>
                    <li>Playwright</li>
                    <li>Vite</li>
                </ul>
            </div>
        </section>

        <section id="contacto">
            <h2>{t.contact.heading}</h2>
            <p>{t.contact.text}
                <a id="mail-link" href="#" style="word-break: break-all;"></a>
            </p>
        </section>

<Footer />

<style>
/* SECCIONES GENERALES, PROYECTOS, HABILIDADES, CONTACTO */
section {
  box-sizing: border-box;
  width: calc(100% - 2rem);
  max-width: 800px;
  margin: 2rem auto;
  background: var(--color-secondary);
  border-radius: 12px;
  box-shadow: var(--shadow-medium);
  padding: clamp(1.25rem, 4vw, 2rem);
}
section[id] {
  scroll-margin-top: 6rem;
}
.proyectos-grid,
.servicios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  gap: clamp(1rem, 3vw, 1.5rem);
  margin-top: 1rem;
}
.cv-download {
  margin-top: 1rem;
  margin-bottom: 0;
}
.cv-download a {
  display: inline-block;
  background: var(--color-primary);
  color: var(--color-background);
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  font-weight: 500;
  text-decoration: none;
}
.cv-download a:hover {
  opacity: 0.85;
}
.servicios-cta {
  margin-top: 1.5rem;
  margin-bottom: 0;
  text-align: center;
}
.proyecto {
  background: var(--color-background);
  border-radius: 8px;
  padding: 1rem;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
  transition: transform 0.2s, box-shadow 0.2s;
}
@media (hover: hover) {
  .proyecto:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 6px 24px rgba(122,182,255,0.25), 0 1.5px 8px rgba(0,0,0,0.18);
    z-index: 2;
  }
}
.proyecto:has(:focus-visible) {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 6px 24px rgba(122,182,255,0.25), 0 1.5px 8px rgba(0,0,0,0.18);
  z-index: 2;
}
@media (prefers-reduced-motion: reduce) {
  .proyecto:hover, .proyecto:has(:focus-visible) {
    transform: none;
  }
}
.skills-group {
  margin-bottom: 1.5rem;
}
.skills-group:last-child {
  margin-bottom: 0;
}
.skills-group h3 {
  margin: 0 0 0.6rem 0;
}
.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  list-style: none;
  padding: 0;
  margin: 0;
}
.skills-list li {
  background: var(--color-background);
  border-radius: var(--border-radius);
  padding: 0.5rem 1rem;
  font-weight: 500;
  color: var(--color-primary);
}

@media (min-width: 1280px) {
  section {
    max-width: 1000px;
    margin: 3rem auto;
    padding: 3rem;
  }
}
@media (max-height: 500px) and (orientation: landscape) {
  section {
    margin: 1rem auto;
    padding: 1.5rem;
  }
}
@media (max-width: 480px) {
  section h2, section h3 {
    text-align: center;
    margin-top: 0.5rem;
    margin-bottom: 0.8rem;
  }
}
</style>
